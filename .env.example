# No credentials needed for the local v0.
PORT=3001
HOST=127.0.0.1
CANONICAL_STORE=memory

# Change CANONICAL_STORE to surreal to use native graph persistence.
# npm run db:up starts the local database described by compose.yaml.
SURREAL_URL=ws://127.0.0.1:8000/rpc
SURREAL_NAMESPACE=canonical
SURREAL_DATABASE=development
SURREAL_USERNAME=root
SURREAL_PASSWORD=canonical-local-only
SURREAL_AUTH_LEVEL=root
# For a Cloud user created ON DATABASE, use SURREAL_AUTH_LEVEL=database
# and set its username/password plus the Cloud endpoint/namespace/database.

# Enables Daytona execution in the API and CLI. Keep this server-side.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
# Optional: use your prepared snapshot; otherwise SDK defaults are used.
DAYTONA_SNAPSHOT=
